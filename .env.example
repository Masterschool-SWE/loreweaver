# Copy to .env and edit.

# --- Auth ---
SECRET_KEY=dev-secret-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
DATABASE_URL=sqlite:///./data/loreweaver.db

# --- Frontend ---
BACKEND_URL=http://localhost:8000

# --- The Keeper (agent) ---
OPENAI_API_KEY=sk-...
KEEPER_MODEL=openai:gpt-4o-mini
KEEPER_TEMPERATURE=0.7
CHECKPOINT_DB_PATH=./data/checkpoints.db

# --- v2: web search (Tavily) ---
TAVILY_API_KEY=tvly-...

# --- v2: RAG (the Worldbook) ---
WORLDBOOK_DIR=./assets/worldbook
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=worldbook
EMBEDDING_MODEL=openai:text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4
RETRIEVAL_MODE=basic

# --- v3: the Archivist (SQL sub-agent) ---
# Model for the SQL sub-agent (defaults to KEEPER_MODEL).
ARCHIVIST_MODEL=openai:gpt-4o-mini

# --- v3: Langfuse tracing (cloud) ---
# Get keys at https://cloud.langfuse.com. Leave unset to disable tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
