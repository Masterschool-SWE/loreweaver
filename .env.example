# Copy to .env and edit. Docker Compose overrides DB/Chroma paths and BACKEND_URL.

# --- Auth ---
# Generate a production secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database (local defaults; Compose uses /data/...) ---
DATABASE_URL=sqlite:///./data/loreweaver.db

# --- Frontend ---
BACKEND_URL=http://localhost:8000

# --- The Keeper (agent) ---
OPENAI_API_KEY=sk-...
KEEPER_MODEL=openai:gpt-4o-mini
KEEPER_TEMPERATURE=0.7
CHECKPOINT_DB_PATH=./data/checkpoints.db
ARCHIVIST_MODEL=openai:gpt-4o-mini

# --- RAG (the Worldbook) ---
WORLDBOOK_DIR=./assets/worldbook
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=worldbook
EMBEDDING_MODEL=openai:text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4
RETRIEVAL_MODE=basic

# --- Optional: web search ---
# TAVILY_API_KEY=tvly-...

# --- Optional: Langfuse tracing ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
